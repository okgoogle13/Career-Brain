      "assisted with",
      "helped to",
      "various roles",
      "all walks of life",
      "hands-on experience",
      "skill set that aligns",
      "make me the ideal"
    ],

    "_overclaim_terms_note": "Clinical, licensed or registered titles Nishant does not hold. WARN ONLY - never auto-rewritten, because these legitimately appear when quoting a position description or describing a colleague. A human resolves every hit.",
    "overclaim_terms": [
      "therapist",
      "psychotherapist",
      "counsellor",
      "psychologist",
      "psychiatrist",
      "social worker",
      "clinician",
      "clinical supervision",
      "therapeutic intervention",
