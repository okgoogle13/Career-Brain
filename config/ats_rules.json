      "company": "organisation",
      "companies": "organisations",
      "industry": "sector",
      "industries": "sectors",
      "job description": "position description",
      "job ad": "position advertisement",
      "competency questions": "key selection criteria"
    },

    "_australian_spelling_note": "Explicit word map only - NEVER an -ize/-ise regex, which would corrupt proper nouns and unrelated words. 'program' is correct Australian usage in community services and is deliberately absent: it must never become 'programme'. Applied as a case-preserving whole-word substitution.",
