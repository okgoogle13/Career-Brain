      "passion for excellence",
      "innovative disruptor",
      "synergise",
      "synergy",
      "hit the ground running",
      "think outside the box",
      "go above and beyond",
      "wealth of experience",
      "excel in this role",
      "excel in roles",
      "ideal candidate",
      "perfect candidate",
      "perfect fit",
      "perfect next step",
      "dedicated professional",
      "unique combination of",
      "unique blend of",
      "unique skillset",
      "value add",
      "best-in-class",
      "world-class"
    ],

