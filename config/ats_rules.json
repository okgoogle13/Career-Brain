{
  "ksc": {
    "word_limits": {
      "context": [40, 100],
      "action": [60, 200],
      "result": [30, 100],
      "total": [200, 500]
    }
  },
  "structure": {
    "columns_max": 1,
    "allow_tables": false,
    "allow_text_boxes": false,
    "allow_inline_objects": false,
    "allowed_headings": ["Summary", "Skills", "Experience", "Education", "Certifications", "Key Achievements"]
  },
  "vocabulary": {
    "forbidden_characters": ["•", "✔", "★", "❖", "●", "✅", "❌", "|"],

    "_banned_phrases_note": "Unambiguous corporate slop. Warned on, never auto-rewritten. Whole-word, case-insensitive.",
    "banned_phrases": [
      "results-driven",
      "results driven",
      "proven track record",
      "track record of delivering",
      "strong communication skills",
      "excellent communication skills",
      "team player",
      "self-starter",
