{
  "policy_version": "1.1",
  "canonical_source": "local_career_brain_database",
  "gemini_targets": [
    "gemini_skills",
    "gemini_spark"
  ],
  "claude_targets": [
    "claude_desktop",
    "claude_duet"
  ],
  "default_sharing_posture": "risk_tiered_task_scoped",
  "data_tiers": {
    "green": {
      "description": "Career material appropriate for default use by approved targets",
      "share_by_default": true,
      "examples": [
        "job_titles",
        "employers",
        "employment_dates",
        "achievement_bullets",
        "verified_metrics",
        "skills",
        "taxonomy_mappings",
        "curated_narratives",
        "anonymised_demo_examples"
      ]
    },
    "amber": {
      "description": "Application material shared only for an active task",
      "share_by_default": false,
      "share_when": [
        "drafting_resume",
        "drafting_cover_letter",
        "drafting_ksc",
        "tailoring_application",
        "reviewing_application"
      ],
      "examples": [
        "full_resume_drafts",
        "ksc_responses",
        "cover_letters",
        "selected_personal_narratives",
        "contact_details_supplied_for_task"
      ]
    },
    "red": {
      "description": "High-sensitivity data excluded from all exports by default",
      "share_by_default": false,
      "require_explicit_user_instruction": true,
      "examples": [
        "government_identifiers",
        "financial_account_details",
        "passwords",
        "api_keys",
        "oauth_tokens",
        "full_home_address",
        "health_information",
        "legal_information",
        "third_party_sensitive_information"
      ]
    }
  },
  "export_profiles": {
    "gemini_resume_context": {
      "purpose": "Resume tailoring and achievement selection",
      "included_tiers": [
        "green"
      ],
      "included_files": [
        "database/career_history_enriched.json",
        "database/skills_and_taxonomy.json"
      ],
      "exclude_source_lineage": false
    },
    "gemini_ksc_context": {
      "purpose": "KSC, STAR, and narrative tailoring",
      "included_tiers": [
        "green"
      ],
      "included_files": [
        "database/career_history_enriched.json",
        "database/ksc_curated_tier1.json",
        "database/skills_and_taxonomy.json"
      ],
      "exclude_source_lineage": false
    },
    "gemini_application_review": {
      "purpose": "Reviewing a specific draft application",
      "included_tiers": [
        "green",
        "amber"
      ],
      "requires_active_task": true,
      "included_files": [
        "database/career_history_enriched.json",
        "database/ksc_curated_tier1.json",
        "database/skills_and_taxonomy.json",
        "user_supplied_application_draft"
      ],
      "exclude_source_lineage": false
    },
    "public_demo": {
      "purpose": "Public AI Studio demonstration only",
      "included_tiers": [
        "green"
      ],
      "require_synthetic_or_anonymised_data": true,
      "included_files": [
        "exports/public_demo/career_history_demo.json",
        "exports/public_demo/skills_and_taxonomy_demo.json"
      ],
      "exclude_source_lineage": true
    },
    "claude_job_application": {
      "purpose": "Drafting and tailoring one specific job application in Claude Desktop or Claude Duet",
      "targets": [
        "claude_desktop",
        "claude_duet"
      ],
      "included_tiers": [
        "green",
        "amber"
      ],
      "requires_active_task": true,
      "included_files": [
        "database/career_history_enriched.json",
        "database/ksc_curated_tier1.json",
        "database/skills_and_taxonomy.json",
        "docs/voice/voice-authenticity-profile.md",
        "docs/voice/ksc-exemplars.local.md",
        "docs/voice/cover-letter-exemplars.local.md",
        "docs/voice/resume-bullet-exemplars.local.md",
        "config/ats_rules.json",
        "context/specs/ksc_standard_v2_spec.md",
        "context/specs/cover_letter_template_spec.md",
        "context/specs/resume_template_spec.md"
      ],
      "staging_dir": "~/Documents/job-pack",
      "delete_staging_after_task": true,
      "referees_and_contact": "supply_in_chat_per_task",
      "exclude_source_lineage": true
    }
  },
  "redaction": {
    "placeholder": "[[REDACTED_SENSITIVE_DATA]]",
    "scan_before_export": true,
    "fields_to_scan": [
      "contact_details",
      "address",
      "phone",
      "email",
      "government_id",
      "financial_details",
      "credentials",
      "health_information"
    ]
  }
}
