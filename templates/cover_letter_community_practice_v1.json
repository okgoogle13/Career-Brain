{
  "schema_version": "2.0",
  "template_id": "cover_letter_community_practice_v1",
  "tier": 1,
  "tier_label": "ATS Clean",
  "doc_type": "cover_letter",
  "target_sector": [
    "community_services",
    "non_profit",
    "healthcare"
  ],
  "region": "AU",
  "placeholder_schema": "PLACEHOLDER_SCHEMA_V2",
  "description": "Community practice family. Georgia body with Arial title-case headings over a terracotta rule, airy rhythm and wide margins for long practice narratives. Single column, ATS-safe.",
  "ats_constraints": {
    "columns": 1,
    "allows_tables": false,
    "allows_images": false,
    "allows_text_boxes": false,
    "allows_headers_footers": false,
    "font_family": "Georgia",
    "content_layer": "body_only",
    "forbidden_glyphs": [
      "•",
      "✔",
      "★",
      "❖",
      "●",
      "✅",
      "❌",
      "|"
    ]
  },
  "palette": {
    "primary": "#7B341E",
    "accent": "#D4865A",
    "body_text": "#1A1A1A",
    "muted_text": "#4A5568",
    "white": "#FFFFFF"
  },
  "typography": {
    "base_font": "Georgia",
    "base_size_pt": 11,
    "line_spacing": 1.35,
    "spacing_after_pt": 6,
    "section_heading_tracking_pt": 0,
    "section_heading_size_pt": 13.0
  },
  "page": {
    "margin_top_cm": 2.4,
    "margin_bottom_cm": 2.4,
    "margin_left_cm": 2.4,
    "margin_right_cm": 2.4,
    "background_color": "#FFFFFF"
  },
  "blocks": [
    {
      "block_id": "name_header",
      "type": "name_block",
      "order": 1,
      "tokens": [
        "{{CONTACT_NAME}}"
      ],
      "content": "{{CONTACT_NAME}}",
      "visualConfig": {
        "font_size_pt": 20.0,
        "font_weight": "bold",
        "font_color": "#7B341E",
        "text_align": "left",
        "padding_top_pt": 0,
        "padding_bottom_pt": 4,
        "letter_spacing": "normal",
        "line_spacing": 1.35,
        "margin_bottom_pt": 4
      }
    },
    {
      "block_id": "contact_info",
      "type": "contact_block",
      "order": 2,
      "tokens": [
        "{{CONTACT_PHONE}}",
        "{{CONTACT_EMAIL}}",
        "{{CONTACT_LOCATION}}"
      ],
      "content": "{{CONTACT_PHONE}}    {{CONTACT_EMAIL}}    {{CONTACT_LOCATION}}",
      "visualConfig": {
        "font_size_pt": 10.5,
        "font_color": "#4A5568",
        "text_align": "left",
        "padding_top_pt": 3,
        "padding_bottom_pt": 18,
        "line_spacing": 1.35,
        "separator": "inline_spaced"
      }
    },
    {
      "block_id": "employer_info",
      "type": "employer_block",
      "order": 3,
      "tokens": [
        "{{EMPLOYER_CONTACT_NAME}}",
        "{{EMPLOYER_ORG}}",
        "{{EMPLOYER_ADDRESS}}"
      ],
      "content": "{{EMPLOYER_CONTACT_NAME}}\n{{EMPLOYER_ORG}}\n{{EMPLOYER_ADDRESS}}",
      "visualConfig": {
        "font_size_pt": 11,
        "font_color": "#1A1A1A",
        "text_align": "left",
        "line_spacing": 1.35,
        "margin_bottom_pt": 14,
        "separator": "line_break"
      }
    },
    {
      "block_id": "salutation",
      "type": "salutation_block",
      "order": 4,
      "tokens": [
        "{{CURRENT_DATE}}",
        "{{SALUTATION}}"
      ],
      "content": "{{CURRENT_DATE}}\n\n{{SALUTATION}}",
      "visualConfig": {
        "font_size_pt": 11,
        "font_color": "#1A1A1A",
        "text_align": "left",
        "line_spacing": 1.35,
        "margin_bottom_pt": 10
      }
    },
    {
      "block_id": "body_paragraphs",
      "type": "body_block",
      "order": 5,
      "tokens": [
        "{{HOOK_PARAGRAPH}}",
        "{{BRIDGE_PARAGRAPH}}",
        "{{EVIDENCE_PARAGRAPH_1}}",
        "{{EVIDENCE_PARAGRAPH_2}}"
      ],
      "content": "{{HOOK_PARAGRAPH}}\n\n{{BRIDGE_PARAGRAPH}}\n\n{{EVIDENCE_PARAGRAPH_1}}\n\n{{EVIDENCE_PARAGRAPH_2}}",
      "visualConfig": {
        "font_size_pt": 11,
        "font_color": "#1A1A1A",
        "text_align": "left",
        "line_spacing": 1.35,
        "paragraph_spacing_after_pt": 10
      }
    },
    {
      "block_id": "closing",
      "type": "closing_block",
      "order": 6,
      "tokens": [
        "{{CLOSING_PARAGRAPH}}"
      ],
      "content": "{{CLOSING_PARAGRAPH}}",
      "visualConfig": {
        "font_size_pt": 11,
        "font_color": "#1A1A1A",
        "text_align": "left",
        "line_spacing": 1.35,
        "margin_top_pt": 8
      }
    }
  ],
  "heading_font_family": [
    "Arial"
  ],
  "family_id": "community_practice"
}
